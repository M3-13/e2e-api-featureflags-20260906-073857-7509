{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": ".",
      "stack": "go",
      "kind": "server",
      "build": [["go", "build", "./..."]],
      "start": ["go", "run", "."],
      "port": 8080,
      "port_env": "PORT",
      "health": { "path": "/healthz", "expect_status": [200] },
      "env": {
        "PORT": { "dev": "8080" },
        "FLAG_API_KEY": {
          "external": true,
          "degraded_without": "the /flags routes stay open, but the service only listens on 127.0.0.1"
        },
        "TLS_CERT_FILE": {
          "external": true,
          "degraded_without": "the service serves plain HTTP on 127.0.0.1 only"
        },
        "TLS_KEY_FILE": {
          "external": true,
          "degraded_without": "the service serves plain HTTP on 127.0.0.1 only"
        },
        "LISTEN_ADDR": {
          "external": true,
          "degraded_without": "the service binds 127.0.0.1"
        }
      }
    }
  ]
}
